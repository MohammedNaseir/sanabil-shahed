# انسخي هذا الملف إلى .env.local وضعي القيم الحقيقية (لا ترفعي .env.local لأي مكان عام)

# رمز دخول لوحة المعلمة — مطلوب. بدونه تبقى لوحة المعلمة معطّلة ويعمل الطلاب فقط.
# اختاري رمزاً طويلاً يصعب تخمينه.
TEACHER_CODE=""

# مدة صلاحية جلسة المعلمة بالساعات (اختياري، الافتراضي 8)
# TEACHER_TOKEN_HOURS=8

# منفذ الخادم (اختياري، الافتراضي 3000)
# PORT=3000

# مجلد حفظ بيانات الطلاب (اختياري، الافتراضي ./data)
# LAB_DATA_DIR=./data

# إذا كان الخادم خلف بروكسي/استضافة (مثل Cloud Run أو Nginx) ضعي عدد طبقات البروكسي، مثلاً 1
# TRUST_PROXY=1
